{
  "name": "parking-lot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "type-check": "tsc --pretty --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:portal": "vite --config vite.portal.config.ts",
    "build:portal": "vite build --config vite.portal.config.ts && node scripts/portal-report.mjs",
    "dev:portal:lan": "vite --config vite.portal.config.ts --host",
    "phone:portal": "npm run build:portal && vite preview --config vite.portal.config.ts --host",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "vite build --config vite.web.config.ts && node scripts/web-report.mjs",
    "preview:web": "vite preview --config vite.web.config.ts"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.7.2",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
